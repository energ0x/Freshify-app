# ── Required ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Database — used by docker-compose AND the backend ────────────────────────
# docker-compose reads POSTGRES_* to configure the postgres container.
# The backend reads DATABASE_URL for direct connection (localhost when running
# outside Docker; docker-compose overrides it to db:5432 inside the container).
POSTGRES_USER=freshify_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=freshify_db

# Local dev (uvicorn outside Docker): port 5435 matches docker-compose.yml
DATABASE_URL=postgresql://freshify_user:changeme@localhost:5435/freshify_db

# ── Mobile client ─────────────────────────────────────────────────────────────
# Your machine's LAN IP so the Expo app can reach the backend
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000

# ── Optional ──────────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
CHARITY_URL=https://savelife.in.ua
CHARITY_NAME=Повернись живим

# pgAdmin (docker-compose.override.yml only)
PGADMIN_EMAIL=admin@freshify.com
PGADMIN_PASSWORD=admin
